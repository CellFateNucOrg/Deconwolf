Bootstrap: docker
From: nvidia/cuda:13.2.0-cudnn-runtime-ubuntu24.04

%labels
    Author "Jennifer Semple"
    Version "1.0"
    Description "Apptainer container for Deconwolf (built from source)"

%environment
    export PATH=/opt/deconwolf/bin:$PATH
    export PATH=/opt/dw_dario/venv/bin:$PATH

%post
    set -e

    echo "Updating base system..."
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        git \
        libfftw3-dev \
        libtiff-dev \
        libpng-dev \
        libjpeg-dev \
        zlib1g-dev \
        libgsl-dev \
        libeigen3-dev \
        libopenblas-dev \
        liblapack-dev \
        libomp-dev \
        wget \
        python3 \
        python3-venv \
        python3-pip \
        ca-certificates
    apt-get clean

    echo "Creating install directory..."
    mkdir -p /opt/deconwolf
    cd /opt/deconwolf

    echo "Cloning Deconwolf..."
    git clone https://github.com/elgw/deconwolf src
    cd src

    echo "Building Deconwolf..."
    mkdir build
    cd build
    cmake ..
    make -j$(nproc)

    echo "Installing Deconwolf..."
    mkdir -p /opt/deconwolf/bin
    cp dw /opt/deconwolf/bin/

    echo "Cleaning up..."
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    
    # Clone our Deconwolf repository
    git clone https://github.com/CellFateNucOrg/Deconwolf.git /opt/dw_dario
    
    # Create venv
    mkdir -p /opt/dw_dario/venv
    python3 -m venv /opt/dw_dario/venv
    
    /opt/dw_dario/venv/bin/pip3 install numpy zarr pypi-json tifffile bioio bioio_tifffile bioio_nd2 bioio_czi bioio_lif bioio_bioformats
    
    # Install img_utils (Python module)
    /opt/dw_dario/venv/bin/pip3 install /opt/dw_dario/img_utils
    

%runscript
    exec dw "$@"
